# ── OLEL – Variables d'environnement (copier en .env) ───────────────────────

# Base de données
POSTGRES_PASSWORD=olel_dev_pwd

# JWT (min 32 caractères en production)
JWT_SECRET=change_me_in_production_use_32_chars_minimum
JWT_REFRESH_SECRET=change_refresh_secret_minimum_32_chars

# Chiffrement des secrets 2FA au repos (S-04) – 64 hex (32 octets) OU passphrase
TOTP_ENCRYPTION_KEY=change_me_64_hex_or_passphrase_min_32_chars

# Origine WebSocket publique pour la CSP (S-05)
WS_PUBLIC_ORIGIN=ws://localhost:4000

# WhatsApp Cloud API (Meta Business)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_VERIFY_TOKEN=olel_webhook_secret_2024
# Secret d'app Meta – requis pour vérifier la signature HMAC du webhook (S-02)
WHATSAPP_APP_SECRET=your_meta_app_secret

# Africa's Talking (SMS / IVR)
AFRICAS_TALKING_KEY=sandbox
AFRICAS_TALKING_USER=sandbox

# Mapbox (optionnel – cartes dashboard)
MAPBOX_TOKEN=pk.eyJxxxxxxxx

# Bot
BOT_API_KEY=bot_internal_api_key_change_me
# Compte système BOT (F-03) – doit exister en base (créé par le seed)
BOT_ACCOUNT_PHONE=+221700000099

# Redis (Bull queues + sessions bot)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontends (zone par défaut pour signalement mobile tant que la connexion n'est pas implémentée)
DEFAULT_ZONE_ID=

# Environnement
NODE_ENV=development
