# ─── OLEL — Variables d'environnement (copier en .env) ─────────────────────────
# Ce fichier doit etre copie en .env a la racine du projet. Le fichier .env est
# charge par docker-compose ET par le backend (via @nestjs/config) ET par Prisma.
# Aucune variable obligatoire ne doit etre absente de ce fichier — sinon le seed
# et le backend echoueront avec "credentials (not available)".

# ── Base de donnees (Postgres + PostGIS) ────────────────────────────────────────
# DATABASE_URL pointe en local (host) ; depuis le conteneur backend, c'est
# automatiquement reecrite par compose (postgres://olel@postgres:5432/...).
DATABASE_URL=postgresql://olel:olel_dev_pwd@localhost:5432/olel?schema=public
POSTGRES_PASSWORD=olel_dev_pwd

# ── Redis (file Bull + cache + sessions bot) ────────────────────────────────────
# Si le port 6379 est deja pris sur ton hote, change ici ET dans docker-compose.
REDIS_HOST=localhost
REDIS_PORT=6380
# Mot de passe Redis : OBLIGATOIRE en production (le backend refuse de démarrer sans)
REDIS_PASSWORD=olel_dev_redis

# ── JWT (auth backend) ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_32_chars_minimum
JWT_REFRESH_SECRET=change_refresh_secret_minimum_32_chars

# ── Chiffrement TOTP (32+ chars en prod, sinon AES s'arrete) ────────────────────
TOTP_ENCRYPTION_KEY=dev_totp_encryption_key_must_be_32_chars

# ── Backend ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origine WebSocket cliente (pour CSP) — adapter en prod
WS_PUBLIC_ORIGIN=http://localhost:3001

# ── Zone par defaut (mobile, ecrasee apres login OTP) ──────────────────────────
DEFAULT_ZONE_ID=00000000-0000-0000-0000-000000000000

# ── WhatsApp Cloud API (Meta Business) ──────────────────────────────────────────
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890
# Jeton de vérification du webhook : obligatoire, aucune valeur par défaut acceptée
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=dev_app_secret_change_me

# ── Africa's Talking (SMS / IVR) ────────────────────────────────────────────────
AFRICAS_TALKING_KEY=sandbox
AFRICAS_TALKING_USER=sandbox
# Numero d'appel sortant IVR (attribue par Africa's Talking) — requis en prod
# IVR_CALLER_ID=+221XXXXXXXXX

# ── Mapbox (optionnel — fond de carte dashboard) ───────────────────────────────
MAPBOX_TOKEN=pk.eyJxxxxxxxx

# ── Bot internal ────────────────────────────────────────────────────────────────
BOT_API_KEY=bot_internal_api_key_change_me

# ── Comptes seed ────────────────────────────────────────────────────────────────
# En production : tout compte sans SEED_*_PASSWORD recoit un mot de passe
# aleatoire jetable (les valeurs par defaut publiques du repo sont refusees).
# SEED_SUPERADMIN_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_PREFET_PASSWORD=
# SEED_SENTINELLE_PASSWORD=
# SEED_CITOYEN_PASSWORD=

# ── Sentry (error tracking) ─────────────────────────────────────────────────────
# Creer un projet sur https://sentry.io — laisser vide pour desactiver
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/YYYY
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/YYYY

# ── Version applicative (optionnel, injectee dans Sentry) ──────────────────────
# APP_VERSION=1.0.0
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Remédiation audit (oct. 2026) ───────────────────────────────────────────────
# Secret des rappels Africa's Talking : ajouter ?key=<valeur> aux URL de rappel
# USSD (/api/v1/ussd/session), SVI (/api/v1/ivr/webhook) et rapports de remise
# SMS (/api/v1/providers/sms/delivery-report). Obligatoire en production.
AT_CALLBACK_SECRET=
# Jeton de collecte Prometheus (Bearer). Sans jeton, /metrics n'est pas exposé en production.
METRICS_TOKEN=
# Clé de signature des URL de médias (défaut : JWT_SECRET) et durée de validité (s)
MEDIA_URL_SECRET=
MEDIA_URL_TTL_S=3600
# Base publique des URL signées des médias (joignable par les navigateurs)
PUBLIC_API_URL=http://localhost:4000/api/v1
# Nombre de proxys de confiance devant le backend (Nginx = 1)
TRUST_PROXY_HOPS=1
# Numéros d'urgence affichés par le mobile, UNIQUEMENT après confirmation officielle (JSON).
# Vide = 18 (sapeurs-pompiers) et 17 (police) seulement.
EMERGENCY_NUMBERS=
# MODE PILOTE — liste des seuls numéros autorisés à recevoir une diffusion
# (E.164, séparés par des virgules). Non vide = toute diffusion vers un autre
# numéro est bloquée côté serveur et tracée « hors liste autorisée ».
# Étapes 2 et 3 du pilote : numéros de l'équipe, puis des volontaires consentants.
# Vide = diffusion normale (seulement après décision écrite d'élargissement).
PILOT_RECIPIENT_ALLOWLIST=
# Mot de passe Grafana (profil monitoring) — aucun défaut
GRAFANA_PASSWORD=
