**/generated/
prisma/*.db

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Coverage & tests ─────────────────────────────────────────
coverage/
.nyc_output/

# ── OS / éditeurs ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Divers ───────────────────────────────────────────────────
*.local
.cache/
tmp/
.claude/

